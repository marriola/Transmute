<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Transmute.Desktop"
             xmlns:models="using:Transmute.Desktop.Models"
             xmlns:views="using:Transmute.Desktop.Views"
             xmlns:vm="using:Transmute.Desktop.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:DataType="vm:RulesPaneViewModel"
             x:Name="RulesPanel"
             x:Class="Transmute.Desktop.Views.RulesPane">
    
    <Design.DataContext>
        <vm:RulesPaneViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
		<local:NavigationListCellWidthConverter x:Key="cellWidthConverter" />

        <DataTemplate x:Key="navigationListTemplate" x:DataType="models:NavigationEntry">
			<Grid ColumnDefinitions="1*,5*,10*" MinWidth="{Binding Bounds.Width, ElementName=HighlightedRule}">
                <!-- Navigation entry layout -->

				<TextBlock Grid.Column="0"
                           IsVisible="{Binding showLineNumber}"
                           Text="{Binding lineNumber}"
                           HorizontalAlignment="Right"
                           Margin="15 0 5 0" />
                <TextBlock Grid.Column="1"
                           IsVisible="{Binding !isSeparator}"
                           Text="{Binding label}" />
                <TextBlock Grid.Column="2"
                           IsVisible="{Binding !isSeparator}"
                           Text="{Binding description}"
                           MaxWidth="{Binding $parent[Grid].Bounds.Width, Converter={StaticResource cellWidthConverter}}"
                           TextTrimming="CharacterEllipsis" />

                <!-- Separator entry layout -->

                <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                           IsVisible="{Binding isSeparator}"
                           TextAlignment="Center"
                           FontWeight="SemiBold"
                           Classes="separator"
                           Text="{Binding label}"
                           MinWidth="{Binding $parent[Grid].Bounds.Width}"
                           Foreground="Black" Background="LightGray" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
		<Style Selector="DataGridRow:selected HyperlinkButton">
			<Setter Property="Foreground" Value="White" />
        </Style>
		<Style Selector="DataGridRow:not(:selected) HyperlinkButton" >
			<Setter Property="Foreground" Value="{DynamicResource HyperlinkColor}" />
        </Style>
        <Style Selector="CheckBox /template/ Path">
			<!--<Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" />-->
            <!--<Setter Property="Fill" Value="#ff0000" />-->
        </Style>
        <Style Selector="HyperlinkButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="0 0 10 0">
        <TabStrip Name="TabStrip" DockPanel.Dock="Top">
			<TabStripItem Content="Rules"
                          IsSelected="{Binding ShowRules}"
                          Classes.dirty="{Binding IsRulesDirty}"
                          ToolTip.Tip="{OnPlatform Alt+R, macOS=⌥R}" />
            <TabStripItem Name="LastTab"
                          Content="Transition Tables"
                          IsSelected="{Binding ShowTransitionTables}"
                          ToolTip.Tip="{OnPlatform Alt+T, macOS=⌥T}" />
        </TabStrip>

        <Panel DockPanel.Dock="Bottom">
            <DockPanel IsVisible="{Binding ShowRules}" VerticalSpacing="10">
                <ComboBox Name="HighlightedRule"
                          IsTextSearchEnabled="True"
                          DockPanel.Dock="Top"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="HighlightedRule_SelectionChanged"
                          ItemsSource="{Binding NavigationList}"
                          ToolTip.Tip="{OnPlatform Ctrl+L, macOS=⌘L}"
                          ItemTemplate="{StaticResource navigationListTemplate}" />
				
                <ae:TextEditor Name="Rules"
                               DockPanel.Dock="Bottom"
                               Focusable="True"
                               BorderThickness="1"
                               WordWrap="True"
                               ShowLineNumbers="True"
                               PointerPressed="Rules_PointerPressed"
                               TextChanged="Rules_TextChanged"
                               Tapped="Rules_Tapped"
                               Document="{Binding Rules}" />
            </DockPanel>

            <DockPanel IsVisible="{Binding ShowTransitionTables}" VerticalSpacing="10">
                <ComboBox Name="SelectedTransitionTable"
                          IsTextSearchEnabled="True"
                          DockPanel.Dock="Top"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="TransitionTable_SelectionChanged"
                          ItemsSource="{Binding TransitionTables}"
                          ToolTip.Tip="{OnPlatform Ctrl+L, macOS=⌘L}"
                          ItemTemplate="{StaticResource navigationListTemplate}" />

                <DataGrid DockPanel.Dock="Bottom"
                          Name="TransitionTableGrid"
                          RowBackground="Transparent"
                          IsReadOnly="True"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="All"
                          BorderThickness="1" BorderBrush="Gray"
                          ItemsSource="{Binding CurrentTransitionTable}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="true" />
						<DataGridTextColumn Header="Origin" Binding="{Binding Origin}" IsReadOnly="true" />
                        <DataGridTemplateColumn Header="Destination">
							<DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:TransitionModel">
									<HyperlinkButton Content="{Binding Destination}"
                                                     Command="{Binding #RulesPanel.GoToDestination}"
                                                     CommandParameter="{Binding Destination}"  />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
						<DataGridTextColumn Header="Input" Binding="{Binding Input}" IsReadOnly="true" />
						<DataGridTextColumn Header="Output" Binding="{Binding Output}" IsReadOnly="true" />
						<DataGridCheckBoxColumn Header="Is Final" Binding="{Binding IsFinal, Mode=OneTime}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Panel>
    </DockPanel>
</UserControl>
